# ESPN Fantasy Baseball credentials
# ------------------------------------
# SWID: found in your ESPN browser cookies. Includes curly braces, e.g. {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
# espn_s2: long alphanumeric string found in your ESPN browser cookies.
#
# How to find them:
#   1. Log in to ESPN Fantasy Baseball in your browser.
#   2. Open browser DevTools → Application (Chrome) or Storage (Firefox).
#   3. Go to Cookies → https://fantasy.espn.com
#   4. Copy the values for "SWID" and "espn_s2".
#
# SECURITY: Treat these like passwords. Never commit this file. Never paste them into shared tools.

ESPN_SWID="{PUT_YOUR_SWID_HERE}"
ESPN_S2="PUT_YOUR_ESPN_S2_COOKIE_HERE"
ESPN_LEAGUE_ID=1600541809
ESPN_SEASON_ID=2026
ESPN_TEAM_ID=3
